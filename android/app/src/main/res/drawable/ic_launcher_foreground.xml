<?xml version="1.0" encoding="utf-8"?>
<!-- Shuro mark as an adaptive-icon foreground: two diagonal gradient
     capsules (lavender→violet, violet→cyan) on transparent, scaled to sit
     inside the 66dp safe zone so every launcher mask crops it cleanly.
     Replaces the Flutter template robot vector. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:rotation="-48.7"
        android:pivotX="54"
        android:pivotY="54">

        <path
            android:pathData="M37.8,33.4 L72.7,33.4"
            android:strokeWidth="23.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="37.8"
                    android:startY="33.4"
                    android:endX="72.7"
                    android:endY="33.4">
                    <item android:offset="0" android:color="#FFA78BFA" />
                    <item android:offset="1" android:color="#FF7C3AED" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:pathData="M35.3,74.6 L70.2,74.6"
            android:strokeWidth="23.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="35.3"
                    android:startY="74.6"
                    android:endX="70.2"
                    android:endY="74.6">
                    <item android:offset="0" android:color="#FF7C3AED" />
                    <item android:offset="1" android:color="#FF00D4FF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
